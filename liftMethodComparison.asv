% Compare lift calculation methods by plotting multiple CL-AoA graphs

clear

%% User Input
NACA = '2412';
N = 200;
AoA = (0:3:15) .* pi ./ 180;

Principal = true;
alt1 = true;
alt2 = false;

addpath('Vortex Panel Method\')
airfoil = generateAirfoil(NACA,N);

if Principal == true
    CL2 = calcCL2(airfoil,AoA);
end
if alt1 == true
    [CL1, ~] = calcCL_CM1(airfoil, AoA);
    plot(AoA .* 180 ./ pi, CL1)
end
if alt2 == true
    CL3 = calcCL3(airfoil,AoA);
end

figure
hold on

plot(AoA .* 180 ./ pi, CL2)
plot(AoA .* 180 ./ pi, CL3)
xlabel('AoA (deg)')
ylabel('CL')
legend('Method 1','Method 2', 'Method 3')
grid on